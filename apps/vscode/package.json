{
  "name": "ai-config",
  "displayName": "AI Config",
  "description": "Define your AI coding configuration once and keep Claude Code, Codex, GitHub Copilot, and OpenCode automatically synchronized.",
  "version": "1.3.1",
  "private": true,
  "license": "MIT",
  "publisher": "aiconfig",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShadyManu/ai-config.git",
    "directory": "apps/vscode"
  },
  "bugs": {
    "url": "https://github.com/ShadyManu/ai-config/issues"
  },
  "homepage": "https://github.com/ShadyManu/ai-config#readme",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ai",
    "ai agents",
    "ai coding",
    "ai configuration",
    "antigravity",
    "claude code",
    "codex",
    "cursor",
    "github copilot",
    "instructions",
    "opencode",
    "prompts",
    "skills",
    "sync",
    "windsurf"
  ],
  "activationEvents": [
    "workspaceContains:**/.ai/config.yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiconfig.init",
        "title": "Initialize Project",
        "category": "AI Config"
      },
      {
        "command": "aiconfig.sync",
        "title": "Synchronize",
        "category": "AI Config"
      },
      {
        "command": "aiconfig.validate",
        "title": "Validate",
        "category": "AI Config"
      },
      {
        "command": "aiconfig.status",
        "title": "Show Status",
        "category": "AI Config"
      },
      {
        "command": "aiconfig.showOutput",
        "title": "Show Output Log",
        "category": "AI Config"
      },
      {
        "command": "aiconfig.refresh",
        "title": "Refresh",
        "category": "AI Config",
        "icon": "$(refresh)"
      },
      {
        "command": "aiconfig.deleteGenerated",
        "title": "Delete Generated Files",
        "category": "AI Config",
        "icon": "$(trash)"
      },
      {
        "command": "aiconfig.removeProject",
        "title": "Remove AI Config from This Project",
        "category": "AI Config",
        "icon": "$(trash)"
      },
      {
        "command": "aiconfig.showDiff",
        "title": "Show Diff",
        "category": "AI Config",
        "icon": "$(diff)"
      },
      {
        "command": "aiconfig.restoreFile",
        "title": "Restore Generated File",
        "category": "AI Config",
        "icon": "$(discard)"
      },
      {
        "command": "aiconfig.addInstruction",
        "title": "Add Instruction",
        "category": "AI Config",
        "icon": "$(add)"
      },
      {
        "command": "aiconfig.addAgent",
        "title": "Add Agent",
        "category": "AI Config",
        "icon": "$(add)"
      },
      {
        "command": "aiconfig.addSkill",
        "title": "Add Skill",
        "category": "AI Config",
        "icon": "$(add)"
      },
      {
        "command": "aiconfig.addCommand",
        "title": "Add Command",
        "category": "AI Config",
        "icon": "$(add)"
      },
      {
        "command": "aiconfig.editArtifact",
        "title": "Edit",
        "category": "AI Config",
        "icon": "$(edit)"
      },
      {
        "command": "aiconfig.deleteArtifact",
        "title": "Delete...",
        "category": "AI Config",
        "icon": "$(trash)"
      },
      {
        "command": "aiconfig.addOverride",
        "title": "Add Provider Override...",
        "category": "AI Config",
        "icon": "$(settings-gear)"
      },
      {
        "command": "aiconfig.editOverride",
        "title": "Edit Override",
        "category": "AI Config",
        "icon": "$(edit)"
      },
      {
        "command": "aiconfig.removeOverride",
        "title": "Remove Override",
        "category": "AI Config",
        "icon": "$(trash)"
      },
      {
        "command": "aiconfig.enableProvider",
        "title": "Enable Provider",
        "category": "AI Config",
        "icon": "$(add)"
      },
      {
        "command": "aiconfig.removeProvider",
        "title": "Remove Provider...",
        "category": "AI Config",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiconfig",
          "title": "AI Config",
          "icon": "resources/aiconfig.svg"
        }
      ]
    },
    "views": {
      "aiconfig": [
        {
          "id": "aiconfig.explorer",
          "name": "AI Config",
          "icon": "resources/aiconfig.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aiconfig.explorer",
        "contents": "No .ai directory was found in this workspace.\n\nAI Config compiles a single canonical configuration into Claude Code, Codex, GitHub Copilot and OpenCode formats.\n\n[Initialize Project](command:aiconfig.init)\n\n---\n\nFound a bug or have a suggestion? [Open GitHub Issues →](https://github.com/ShadyManu/ai-config/issues)"
      }
    ],
    "submenus": [
      {
        "id": "aiconfig.add",
        "label": "Add",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "aiconfig.showDiff",
          "when": "false"
        },
        {
          "command": "aiconfig.restoreFile",
          "when": "false"
        },
        {
          "command": "aiconfig.editArtifact",
          "when": "false"
        },
        {
          "command": "aiconfig.deleteArtifact",
          "when": "false"
        },
        {
          "command": "aiconfig.addOverride",
          "when": "false"
        },
        {
          "command": "aiconfig.editOverride",
          "when": "false"
        },
        {
          "command": "aiconfig.removeOverride",
          "when": "false"
        },
        {
          "command": "aiconfig.enableProvider",
          "when": "false"
        },
        {
          "command": "aiconfig.removeProvider",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "aiconfig.sync",
          "when": "view == aiconfig.explorer",
          "group": "navigation@1"
        },
        {
          "command": "aiconfig.refresh",
          "when": "view == aiconfig.explorer",
          "group": "navigation@2"
        },
        {
          "submenu": "aiconfig.add",
          "when": "view == aiconfig.explorer",
          "group": "navigation@3"
        },
        {
          "command": "aiconfig.deleteGenerated",
          "when": "view == aiconfig.explorer",
          "group": "1_danger@1"
        },
        {
          "command": "aiconfig.removeProject",
          "when": "view == aiconfig.explorer",
          "group": "1_danger@2"
        }
      ],
      "aiconfig.add": [
        {
          "command": "aiconfig.addAgent",
          "group": "artifacts@1"
        },
        {
          "command": "aiconfig.addCommand",
          "group": "artifacts@2"
        },
        {
          "command": "aiconfig.addInstruction",
          "group": "artifacts@3"
        },
        {
          "command": "aiconfig.addSkill",
          "group": "artifacts@4"
        }
      ],
      "view/item/context": [
        {
          "command": "aiconfig.showDiff",
          "when": "view == aiconfig.explorer && viewItem == aiconfig.driftedFile",
          "group": "inline@1"
        },
        {
          "command": "aiconfig.restoreFile",
          "when": "view == aiconfig.explorer && viewItem == aiconfig.driftedFile",
          "group": "inline@2"
        },
        {
          "command": "aiconfig.addOverride",
          "when": "view == aiconfig.explorer && viewItem == aiconfig.item.overridable",
          "group": "inline@1"
        },
        {
          "command": "aiconfig.editArtifact",
          "when": "view == aiconfig.explorer && (viewItem == aiconfig.item || viewItem == aiconfig.item.overridable)",
          "group": "inline@2"
        },
        {
          "command": "aiconfig.deleteArtifact",
          "when": "view == aiconfig.explorer && (viewItem == aiconfig.item || viewItem == aiconfig.item.overridable)",
          "group": "inline@3"
        },
        {
          "command": "aiconfig.editOverride",
          "when": "view == aiconfig.explorer && viewItem == aiconfig.override",
          "group": "inline@1"
        },
        {
          "command": "aiconfig.removeOverride",
          "when": "view == aiconfig.explorer && viewItem == aiconfig.override",
          "group": "inline@2"
        },
        {
          "command": "aiconfig.sync",
          "when": "view == aiconfig.explorer && viewItem == aiconfig.configurationSection",
          "group": "aiconfig.configuration@1"
        },
        {
          "submenu": "aiconfig.add",
          "when": "view == aiconfig.explorer && viewItem == aiconfig.configurationSection",
          "group": "aiconfig.configuration@2"
        },
        {
          "command": "aiconfig.deleteGenerated",
          "when": "view == aiconfig.explorer && viewItem == aiconfig.configurationSection",
          "group": "aiconfig.danger@1"
        },
        {
          "command": "aiconfig.removeProject",
          "when": "view == aiconfig.explorer && viewItem == aiconfig.configurationSection",
          "group": "aiconfig.danger@2"
        },
        {
          "command": "aiconfig.enableProvider",
          "when": "view == aiconfig.explorer && viewItem == aiconfig.provider.disabled",
          "group": "inline@1"
        },
        {
          "command": "aiconfig.removeProvider",
          "when": "view == aiconfig.explorer && viewItem == aiconfig.provider.enabled",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "AI Config",
      "properties": {
        "aiconfig.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the AI Config status bar item."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest": "pnpm run compile-tests && pnpm run build",
    "test": "vscode-test",
    "package": "pnpm run build && vsce package --no-dependencies --out ../../ai-config.vsix"
  },
  "devDependencies": {
    "@aiconfig/core": "workspace:*",
    "@aiconfig/providers": "workspace:*",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "1.107.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.6.0"
  }
}
