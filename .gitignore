node_modules
dist
out
*.tsbuildinfo
.vscode-test/
*.vsix
*.tgz

# Provider output produced by running AI Config against an example repository
# during manual development. Only the canonical `.ai/` sources are checked in.
# Anchored to `examples/` on purpose: the same names at the repository root are
# this project's own configuration and must stay tracked.
/examples/*/.ai/.generated.json
/examples/*/.agents/
/examples/*/.claude/
/examples/*/.codex/
/examples/*/.github/
/examples/*/.opencode/
/examples/*/AGENTS.md

# Ignore the AI Provider's folders
.ai/.generated.json
.claude/
.codex/
.agents/
.opencode/
AGENTS.md

# The scratch folder the VS Code integration tests open. It has to exist when
# the editor launches, and everything the tests put in it is disposable.
/apps/vscode/test-workspace/*
!/apps/vscode/test-workspace/.gitkeep
